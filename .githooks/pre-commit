#!/bin/sh
# .githooks/pre-commit
# 防呆检查：阻止把不应出现在 GitHub 上的内容加入提交，并对源码执行 ESLint。
# 启用方式：git config core.hooksPath .githooks

set -u

files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

# 允许随仓库分发的 Markdown 文档（README 是 GitHub 首页说明，必须保留）
# 一律小写：路径判断使用 lower，白名单也必须是小写才能匹配
ALLOW_MD="readme.md agents.md claude.md contributing.md changelog.md license.md security.md"
bad=""

reject() {
  bad="${bad}
  x  $1"
}

while IFS= read -r f; do
  [ -z "$f" ] && continue

  # 统一转小写：防止 .ENV / SECRET.MD / NODE_MODULES 这类大小写绕过
  lower=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')

  # 环境变量示例模板允许提交
  [ "$lower" = ".env.example" ] && continue

  # 1) 构建产物、工具数据、IDE 配置、临时文件
  case "$lower" in
    node_modules/*|*/.next/*|.next/*|.vercel/*|out/*|build/*|dist/*|coverage/*|\
    .workbuddy/*|.codebuddy/*|.vscode/*|.idea/*|tmp/*|.tmp/*|*.bak|\
    *.tsbuildinfo|*.log|*.tmp|thumbs.db|desktop.ini|.ds_store|.npmrc)
      reject "$f  -> 构建产物 / 工具数据 / IDE / 临时文件"
      continue
      ;;
  esac

  # 2) 环境变量与密钥证书（后缀与文件名都判断）
  case "$lower" in
    .env|.env.*|*.env|*.key|*.pem|*.p12|*.pfx|*.crt|*.p8|id_rsa|id_ed25519|*secret*.json|*credentials*)
      reject "$f  -> 环境变量 / 密钥证书"
      continue
      ;;
  esac

  # 3) Markdown 白名单：.github 下不再无条件放行，仅允许约定的模板文件
  case "$lower" in
    *.md)
      case "$lower" in
        .github/issue_template/*.md|.github/pull_request_template.md|.github/issue_template.md) ;;
        *)
          case " $ALLOW_MD " in
            *" $lower "*) ;;
            *) reject "$f  -> .md 未在白名单（仅允许 README/AGENTS/CLAUDE 等项目文档）" ;;
          esac
          ;;
      esac
      ;;
  esac
done <<EOF
$files
EOF

# 4) 新增内容中疑似私钥 / token
if git diff --cached --diff-filter=ACM -U0 -- . | grep -qiE '^\+.*(BEGIN (RSA |EC |OPENSSH |)?PRIVATE KEY|ghp_[A-Za-z0-9]{30,}|sk-[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,})'; then
  reject "暂存内容中疑似包含私钥或 token（请检查新增行）"
fi

# 5) 暂存的 TS/TSX 必须通过 ESLint
lint_targets=$(printf '%s\n' "$files" | grep -Ei '\.(ts|tsx)$' || true)
if [ -n "$lint_targets" ]; then
  lint_log="$(git rev-parse --git-dir)/pre-commit-eslint.log"
  # shellcheck disable=SC2086
  if ! npx --no-install eslint $lint_targets > "$lint_log" 2>&1; then
    cat "$lint_log" >&2
    reject "ESLint 检查未通过（运行 npm run lint 查看完整报错）"
  fi
fi

if [ -n "$bad" ]; then
  printf '\n[pre-commit] 以下内容不允许提交到 GitHub：\n' >&2
  printf '%s\n' "$bad" >&2
  printf '\n用 git restore --staged <文件> 取消暂存后再提交。\n' >&2
  exit 1
fi

count=$(printf '%s\n' "$files" | wc -l | tr -d ' ')
printf '[pre-commit] 检查通过，共 %s 个文件\n' "$count"
exit 0
